# ============================================================
# Copy this file to ".env" and fill in your REAL keys.
# Never commit the real ".env" file — only .env.example goes to git/submission.
# ============================================================

# VirusTotal free-tier API key (https://www.virustotal.com/gui/my-apikey)
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB free-tier API key (https://www.abuseipdb.com/account/api)
ABUSE_API_KEY=your_abuseipdb_api_key_here

# Master password used to derive the local encryption key (Part C - Encryption)
# Pick your own passphrase; it never leaves your machine.
VAULT_PASSPHRASE=change-this-passphrase

# Path to the SQLite database used across the project
DB_PATH=../threat_intelligence.db
